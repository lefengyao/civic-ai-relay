# 预编译二进制镜像：FROM 钉死的 runtime 基座，不再 FROM 上一个迭代 tag。
#
# 基座 civic-relay-runtime:base 由 civic-relay:workspace-20261026 重打标签而来，
# 内含完整的 distroless 运行时布局：/app/config 与 /app/data（属主 65532）、
# CA 根证书、Asia/Shanghai 与 UTC 时区、USER 65532、WORKDIR /app、healthcheck。
#
# ⚠️ 删掉基座会断掉重建能力（服务器拉不到 gcr.io 与 Docker Hub），
#    清理旧镜像时必须保留 civic-relay-runtime:base。
#
# 基座里带一个旧二进制（约 12MB），会被下面的 COPY 遮蔽；
# 镜像体积恒定在 ~38MB，不再随迭代次数叠加。
#
# 为什么不用 Dockerfile.relay：它是多阶段构建，build 阶段要拉
# golang:1.27-bookworm，而部署服务器访问不到 Docker Hub。二进制在本机
# 用 go build 产出后上传为 civic-bin.new，这里只负责组装运行层。
#
#   docker build -f Dockerfile.prebuilt -t civic-relay:<版本> .
#   sed -i 's/^CIVIC_RELAY_VERSION=.*/CIVIC_RELAY_VERSION=<版本>/' .env
#   docker compose up -d          # 不要加 --build，那会走 Dockerfile.relay
FROM civic-relay-runtime:base

COPY --chmod=755 civic-bin.new /civic-relay

ENTRYPOINT ["/civic-relay"]
