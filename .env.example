# Go relay configuration example.
# Leave ADMIN_API_KEY and RELAY_ENCRYPTION_KEY empty on first start so the
# application can generate them in the external configuration directory.
ADMIN_API_KEY=
RELAY_ENCRYPTION_KEY=
HOST=0.0.0.0
PORT=8000
DB_PATH=data/relay.db
DOCS_ENABLED=false
MODEL_AUTO_SYNC=false
MODEL_SYNC_INTERVAL=30m
MEMORY_LIMIT_MB=200
MAX_BODY_MB=8
MAX_OUTPUT_TOKENS=4096
MAX_STREAM_DURATION=1800s
GLOBAL_CONCURRENCY_LIMIT=8
RPM_LIMIT=30
TOKEN_LIMIT_5H=100000
TOKEN_LIMIT_DAILY=20000
UPSTREAM_CONNECT_TIMEOUT=10s
UPSTREAM_READ_TIMEOUT=300s
UPSTREAM_WRITE_TIMEOUT=30s
UPSTREAM_POOL_TIMEOUT=10s
RETENTION_DAYS=7
LOG_LEVEL=INFO
