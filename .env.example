# relay.env 模板（Go 版 Civic Relay 的外部配置文件）。
# 注意：这是 relay.env 的模板，不是 docker compose 的 .env 文件。
# 首次启动时 ADMIN_API_KEY 与 RELAY_ENCRYPTION_KEY 留空，程序会在
# 配置文件所在目录自动生成，并写出一次性的 bootstrap-admin-key.txt。
#
# DB_PATH 为相对路径时，相对于进程的工作目录解析：
#   - 容器内工作目录是 /app，因此 data/relay.db = /app/data/relay.db（在挂载卷上）；
#   - 本机直接运行 go run 时是仓库根目录。
# 若工作目录不确定，请改成绝对路径。
ADMIN_API_KEY=
RELAY_ENCRYPTION_KEY=
HOST=0.0.0.0
PORT=8000
DB_PATH=data/relay.db
DOCS_ENABLED=false
MODEL_AUTO_SYNC=false
MODEL_SYNC_INTERVAL=30m
MEMORY_LIMIT_MB=200
MAX_BODY_MB=8
MAX_OUTPUT_TOKENS=4096
MAX_STREAM_DURATION=1800s
GLOBAL_CONCURRENCY_LIMIT=8
RPM_LIMIT=30
TOKEN_LIMIT_5H=100000
TOKEN_LIMIT_DAILY=20000
UPSTREAM_CONNECT_TIMEOUT=10s
UPSTREAM_READ_TIMEOUT=300s
UPSTREAM_WRITE_TIMEOUT=30s
UPSTREAM_POOL_TIMEOUT=10s
RETENTION_DAYS=7
LOG_LEVEL=INFO
